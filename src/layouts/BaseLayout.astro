---
import SiteNavbar from "@components/SiteNavbar.astro";
import SiteFooter from "@components/SiteFooter.astro";
import { Font } from "astro:assets";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * When true, <main> gets no top padding so a full-bleed hero can sit under
   * the transparent fixed navbar. When false (default), <main> is offset by the
   * bar height so page content clears the fixed nav.
   */
  hero?: boolean;
}

const {
  title = "Portland Bike Polo",
  description = "Hardcourt bike polo in Portland, Oregon. All skill levels welcome.",
  hero = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0e10" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <!--
      Space Grotesk is self-hosted by Astro's font provider (no third-party host,
      so no preconnect is needed). font-display:swap is set in astro.config.
      Preload just the critical latin/normal file so the hero headline never FOITs.
    -->
    <Font
      cssVariable="--font-space-grotesk"
      preload={[{ subset: "latin", style: "normal" }]}
    />
  </head>
  <body class="bg-asphalt text-chalk">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ball focus:text-asphalt focus:px-4 focus:py-2 focus:font-bold"
    >
      Skip to main content
    </a>

    <SiteNavbar />

    <main
      id="main-content"
      style={hero ? undefined : "padding-top: var(--nav-h)"}
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
