---
// Band 3 — Play / when-and-where. THE SIGNATURE.
// The quiet typographic payoff to the loud photographic hero: oversized day
// names with each day's format + description grouped directly beside it, and one
// loud interactive accent — the filled amber Discord CTA that routes newcomers
// to loaner gear in #pickup. Schedule content is passed in from the `play`
// Keystatic singleton (index.astro) — no clock times are invented; only the day,
// format, description, and location the content actually provides are shown.
interface Props {
  schedule: readonly {
    day: string;
    description: string;
    format?: string;
    newcomer?: boolean;
  }[];
  location: { name: string; address: string };
}

const { schedule, location } = Astro.props;

const mapsQuery = encodeURIComponent(`${location.name} ${location.address}`);
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const discordHref = "https://discord.gg/GsEQT9THkw";
---

<section class="home-band home-reveal bg-asphalt-raised" aria-labelledby="play-heading">
  <div class="mx-auto max-w-6xl px-4">
    <h2
      id="play-heading"
      class="text-concrete text-xs font-medium uppercase tracking-[0.1em] mb-4"
    >
      When and where
    </h2>
    <p class="sched-lede text-chalk text-pretty mb-8">
      New to polo? Come to a Casual pickup — Friday or Sunday. All levels, no
      experience needed.
    </p>

    <ol class="sched-list">
      {
        schedule.map(({ day, description, format, newcomer }) => (
          <li class="sched-row">
            <span class="sched-day tabular-nums text-chalk">{day}</span>
            <div class="sched-detail">
              {(format || newcomer) && (
                <p class="sched-format">
                  {format && <span class="text-concrete">{format}</span>}
                  {newcomer && (
                    <span class="sched-newcomer">Good for first-timers</span>
                  )}
                </p>
              )}
              <p class="sched-desc text-concrete text-pretty">{description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="sched-cta">
      <p class="sched-cta-text text-chalk text-pretty">
        No gear? We’ve got loaner bikes and mallets — give us a heads-up in
        <span class="text-chalk font-medium" translate="no">#pickup</span> on Discord
        and we’ll bring them for you.
      </p>
      <a
        href={discordHref}
        target="_blank"
        rel="noopener noreferrer"
        class="sched-discord inline-flex items-center bg-ball px-6 py-3 font-medium text-asphalt
               transition-colors hover:bg-ball-hover
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball
               focus-visible:ring-offset-2 focus-visible:ring-offset-asphalt"
      >
        Get in touch on Discord →<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    <div class="sched-footer">
      <div>
        <p class="text-chalk">{location.name}</p>
        <p class="text-concrete text-sm">{location.address}</p>
      </div>
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="sched-directions text-concrete transition-colors hover:text-chalk
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
      >
        Get directions →<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .sched-lede {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    max-width: 34rem;
  }

  /* Exactly ONE neutral chalk-toned hairline — the deliberate court boundary. */
  .sched-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  /* Mobile: day stacked over its detail. Only row-gap is set (no column-gap),
     so the md subgrid below can inherit the list's column-gap cleanly. */
  .sched-row {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }

  .sched-day {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .sched-format {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  /* Newcomer-friendly marker — the warm signal for a stranger scanning for the
     safe day. Neutral chalk, NOT the reserved accent orange (which stays
     interactive-only per the design system): it stands out by brightness. A
     concrete middot sets it off from the uppercase format label when both show. */
  .sched-newcomer {
    color: var(--color-chalk);
    text-transform: none;
    letter-spacing: normal;
  }
  .sched-format > span + .sched-newcomer::before {
    content: "·";
    margin-right: 0.6rem;
    color: var(--color-concrete);
  }

  .sched-desc {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.5;
    justify-self: start;
  }

  @media (min-width: 48rem) {
    /* The list becomes the grid; every row is a subgrid spanning both tracks,
       so the day column is sized to the WIDEST day across all rows and every
       description lines up on one shared left edge (no per-row raggedness).
       column-gap is declared once here and inherited by each row's subgrid. */
    .sched-list {
      display: grid;
      grid-template-columns: max-content 1fr;
      column-gap: clamp(2rem, 4vw, 4rem);
    }
    .sched-row {
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      /* Small detail text sits on the big day's baseline for a clean type line. */
      align-items: baseline;
      padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    }
    .sched-detail {
      justify-self: start;
      text-align: left;
    }
  }

  /* Primary conversion block — the single loud accent lives in this button. */
  .sched-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
  }

  .sched-cta-text {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    max-width: 34rem;
    flex: 1 1 20rem;
  }

  .sched-discord {
    flex-shrink: 0;
  }

  .sched-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .sched-directions {
    font-size: 1rem;
    font-weight: 500;
  }
</style>
