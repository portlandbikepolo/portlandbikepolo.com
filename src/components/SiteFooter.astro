---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/play", label: "Play" },
];
---

<footer class="bg-asphalt mt-24">
  <div class="max-w-6xl mx-auto px-4 py-16 flex flex-col gap-8 border-t border-line">

    <!-- Nav links -->
    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap gap-6 list-none" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-concrete hover:text-chalk text-sm transition-colors
                     focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <SocialLinks />

    <!-- Non-profit info -->
    <div class="text-concrete text-sm leading-relaxed max-w-2xl flex flex-col gap-1">
      <p>
        Portland Bike Polo is a non-profit 501(c)(3) organization focused on
        building a competitive, diverse, and inclusive bike polo community in
        the Pacific Northwest.
      </p>
      <p>Federal Tax ID: #83-3435866</p>
    </div>

    <!-- Copyright -->
    <p class="text-concrete text-sm">© {year} Portland Bike Polo</p>
  </div>
</footer>
