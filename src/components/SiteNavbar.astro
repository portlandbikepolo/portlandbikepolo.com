---
import SocialLinks from "./SocialLinks.astro";

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/play", label: "Play" },
  { href: "/tournaments", label: "Tournaments" },
  { href: "/coc", label: "Code of Conduct" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-asphalt border-b-2 border-chalk">
  <nav
    aria-label="Main navigation"
    class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between"
  >
    <a
      href="/"
      class="text-chalk font-bold text-sm uppercase tracking-[0.2em] hover:text-ball transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
    >
      Portland Bike Polo
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex gap-8 list-none" role="list">
      {
        navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath.startsWith(href) ? "page" : undefined}
              class="nav-link text-sm tracking-wide uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
      class="md:hidden p-2 text-concrete hover:text-chalk focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
    >
      <svg
        id="icon-open"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        id="icon-close"
        class="hidden"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 top-16 bg-asphalt z-30 flex flex-col p-8 gap-0"
  >
    {
      navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath.startsWith(href) ? "page" : undefined}
          class="text-chalk text-2xl font-bold tracking-wide uppercase border-b border-[#1a1a1a] py-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball aria-[current=page]:text-ball"
        >
          {label}
        </a>
      ))
    }
    <div class="mt-6"><SocialLinks /></div>
    <p class="text-concrete text-xs uppercase tracking-[0.15em] mt-auto">
      Alberta Park · Portland, OR
    </p>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    padding-bottom: 3px;
    transition: color 0.2s ease;
    color: var(--color-concrete);
  }
  .nav-link:hover {
    color: var(--color-chalk);
  }
  .nav-link[aria-current="page"] {
    color: var(--color-ball);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-ball);
    transition: width 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }
</style>

<script>
  const btn = document.getElementById("menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  function openMenu(focusFirst = true) {
    btn.setAttribute("aria-expanded", "true");
    btn.setAttribute("aria-label", "Close navigation menu");
    menu.classList.remove("hidden");
    iconOpen.classList.add("hidden");
    iconClose.classList.remove("hidden");
    trapFocus(menu, focusFirst);
  }

  function closeMenu() {
    btn.setAttribute("aria-expanded", "false");
    btn.setAttribute("aria-label", "Open navigation menu");
    menu.classList.add("hidden");
    iconOpen.classList.remove("hidden");
    iconClose.classList.add("hidden");
    btn.focus();
  }

  btn.addEventListener("click", (e) => {
    if (btn.getAttribute("aria-expanded") === "true") {
      closeMenu();
    } else {
      // e.detail === 0 means keyboard-triggered click (Enter/Space); focus first item only then
      openMenu(e.detail === 0);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
      closeMenu();
    }
  });

  function trapFocus(el: HTMLElement, focusFirst = true) {
    const focusable = Array.from(
      el.querySelectorAll<HTMLElement>(
        'a[href], button, [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => !el.closest("[hidden]"));

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (focusFirst) first?.focus();

    el.addEventListener("keydown", function handler(e: KeyboardEvent) {
      if (e.key !== "Tab") return;
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
      if (menu.classList.contains("hidden")) {
        el.removeEventListener("keydown", handler);
      }
    });
  }
</script>
