---
// Band 1 — Hero. The single "loud" (photographic) moment.
// Real <img> layers stacked absolutely, each with intrinsic width/height so the
// full-bleed hero causes no layout shift. The first frame loads eagerly with
// high priority; the rest lazy. Frames cross-fade slowly using opacity ONLY and
// auto-advance on a calm interval — no arrows/dots chrome. Under
// prefers-reduced-motion a single static frame shows (no crossfade, no advance).
import { getImage } from "astro:assets";
import heroBg from "@assets/images/polo/polo_01.webp";

interface Props {
  photos?: { src: string; width: number; height: number }[];
}

const { photos = [] } = Astro.props;

// Fallback: if the slideshow singleton is empty, show one optimized frame.
const optimizedBg = await getImage({ src: heroBg, format: "webp", width: 1920 });
const fallbackHeight = Math.round((1920 * heroBg.height) / heroBg.width);

const frames =
  photos.length > 0
    ? photos
    : [{ src: optimizedBg.src, width: 1920, height: fallbackHeight }];
---

<section
  id="hero"
  class="hero relative flex items-end overflow-hidden min-h-svh md:min-h-[85vh]"
>
  <!-- Photographic frames — stacked, cross-fade via opacity only -->
  <div class="hero-frames absolute inset-0">
    {
      frames.map((frame, i) => (
        <img
          src={frame.src}
          width={frame.width}
          height={frame.height}
          alt={
            i === 0 ? "Bike polo players on the court at Alberta Park" : ""
          }
          aria-hidden={i === 0 ? undefined : "true"}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          decoding={i === 0 ? "sync" : "async"}
          class:list={["hero-frame", { "is-active": i === 0 }]}
        />
      ))
    }
  </div>

  <!-- Faint top scrim: keeps the transparent navbar legible over any frame -->
  <div class="hero-scrim-top" aria-hidden="true"></div>
  <!-- Bottom overlay: guarantees the hero text stays legible -->
  <div class="hero-scrim-bottom" aria-hidden="true"></div>

  <!-- Minimal text, bottom-left, sentence case. One CTA only. -->
  <div class="hero-content relative z-10 mx-auto w-full max-w-6xl pb-10 md:pb-16">
    <h1 class="hero-title text-chalk text-balance">Portland bike polo</h1>
    <p class="hero-tagline text-chalk/85 mt-3 max-w-md text-pretty">
      Hardcourt bike polo at Alberta Park. All levels — come as you are.
    </p>
    <a
      href="/play"
      class="hero-cta mt-6 inline-flex items-center bg-ball px-6 py-3 font-medium text-asphalt
             transition-colors hover:bg-ball-hover
             focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball
             focus-visible:ring-offset-2 focus-visible:ring-offset-asphalt"
    >
      Come play
    </a>
  </div>
</section>

<script>
  function initHero() {
    const hero = document.getElementById("hero");
    if (!hero) return;

    const frames = Array.from(
      hero.querySelectorAll<HTMLElement>(".hero-frame"),
    );
    // One frame (or reduced motion) → single static image, nothing to animate.
    if (frames.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let i = 0;
    let timer: number | undefined;
    const INTERVAL = 5000;

    function advance() {
      frames[i].classList.remove("is-active");
      i = (i + 1) % frames.length;
      frames[i].classList.add("is-active");
    }

    function start() {
      timer = window.setInterval(advance, INTERVAL);
    }
    function stop() {
      if (timer !== undefined) window.clearInterval(timer);
    }

    start();

    // Calm: pause the crossfade while the tab is hidden.
    document.addEventListener("visibilitychange", () => {
      stop();
      if (!document.hidden) start();
    });
  }

  initHero();
</script>

<style>
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .hero-frame.is-active {
    opacity: 1;
  }

  /* Slow crossfade — opacity only, interruptible. Motion gated. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-frame {
      transition: opacity 1.2s ease;
    }
  }

  /* Deeper, taller scrim so chalk nav links + the wordmark clear AA on first
     paint over the bright graffiti photo — a mid stop keeps the full nav zone
     (top ~4rem) dark before fading out. */
  .hero-scrim-top {
    position: absolute;
    inset: 0 0 auto 0;
    height: 8rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.7),
      rgba(0, 0, 0, 0.45) 50%,
      transparent
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-scrim-bottom {
    position: absolute;
    inset: auto 0 0 0;
    height: 65%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72),
      rgba(0, 0, 0, 0.12) 55%,
      transparent
    );
    z-index: 1;
    pointer-events: none;
  }

  /* Clear notches on full-bleed hero (landscape) — never less than the base 1rem gutter. */
  .hero-content {
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.6;
  }
</style>
