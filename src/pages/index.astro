---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/HeroSection.astro";
import InfoCards from "@components/InfoCards.astro";
import SupportedVendors from "@components/SupportedVendors.astro";
import { createReader } from "@keystatic/core/reader";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import keystaticConfig from "../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const heroSlideshow = await reader.singletons.heroSlideshow.read();

// Eager-import all polo images so Vite processes them
const poloImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/polo/*.{webp,jpg,jpeg,png}",
  { eager: true },
);

// Resolve each entry to an optimized URL — entries are plain filename strings
const photos = (
  await Promise.all(
    (heroSlideshow?.images ?? []).map(async (filename) => {
      if (!filename) return null;
      const key = `../assets/images/polo/${filename}`;
      const mod = poloImages[key];
      if (!mod) return null;
      const optimized = await getImage({
        src: mod.default,
        width: 1920,
        format: "webp",
      });
      return { src: optimized.src };
    }),
  )
).filter((p): p is { src: string } => p !== null);
---

<BaseLayout>
  <HeroSection photos={photos} />
  <InfoCards />
  <SupportedVendors />
</BaseLayout>
