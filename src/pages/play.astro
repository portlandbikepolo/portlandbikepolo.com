---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import mapImage from "@assets/images/map.png";
import hecklersLogo from "@assets/images/brands/hecklers_alley_banner.jpg";
import enforcer13 from "@assets/images/brands/enforcer13.jpg";

// Structured fields via Keystatic reader
const reader = createReader(process.cwd(), keystaticConfig);
const playData = await reader.singletons.play.read();
if (!playData) throw new Error("Play content not found");

// Intro markdoc via Astro content collection
const entry = await getEntry("keystatic", "play");
if (!entry) throw new Error("Play entry not found");
const { Content: Intro } = await render(entry);
---

<BaseLayout title="Play — Portland Bike Polo">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1
      class="text-chalk text-5xl md:text-6xl font-medium tracking-tight text-balance mb-10"
    >
      Play
    </h1>

    <div
      class="prose prose-invert prose-p:text-chalk prose-headings:text-chalk prose-a:text-ball prose-p:leading-loose prose-p:text-pretty max-w-none mb-16"
    >
      <Intro />
    </div>

    <section class="mb-16">
      <p class="text-concrete text-sm mb-4">When and where</p>
      <ul
        class="text-chalk text-sm leading-relaxed list-none flex flex-col gap-1 mb-6"
      >
        {
          playData.schedule.map(({ day, format, description }) => (
            <li>
              <span class="text-concrete">{day}</span>
              {format && <> — <em>{format}</em></>} — {description}
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col gap-3 mb-8">
        <p class="text-chalk text-sm leading-loose text-pretty">
          No gear? We've got loaner bikes and mallets — give us a heads-up in
          <span class="font-medium">#pickup</span> on Discord and we'll bring
          them for you.
        </p>
        <a
          href="https://discord.gg/GsEQT9THkw"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center self-start bg-ball px-5 py-2.5 text-sm font-medium text-asphalt
                 transition-colors hover:bg-ball-hover
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball
                 focus-visible:ring-offset-2 focus-visible:ring-offset-asphalt"
        >
          Get in touch on Discord →
        </a>
      </div>
      <figure>
        <Image
          src={mapImage}
          alt="Map of Alberta Park in Portland, OR"
          class="w-full"
        />
        <figcaption class="text-concrete text-xs mt-2">
          {playData.location.name} — {playData.location.address}
        </figcaption>
      </figure>
    </section>

    <section class="mb-16">
      <p class="text-concrete text-sm mb-4">What to bring</p>
      <p class="text-chalk text-sm leading-loose whitespace-pre-line">
        {playData.equipment}
      </p>
    </section>

    <section class="mb-16">
      <p class="text-concrete text-sm mb-4">What kind of bike</p>
      <p class="text-chalk text-sm leading-loose whitespace-pre-line mb-8">
        {playData.bikeType}
      </p>
      <div class="flex flex-col gap-3">
        <p class="text-concrete text-sm">Featured frame</p>
        <Image
          src={enforcer13}
          alt="Enforcer 13 bike polo frame"
          class="w-full"
        />
        <p class="text-chalk font-medium">Enforcer 13</p>
        <a
          href="https://www.enforcerbikes.com/enforcer-13"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ball text-sm hover:text-ball-hover transition-colors
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
        >
          View at Enforcer Bikes →
        </a>
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <p class="text-concrete text-sm">Get your gear</p>
      <Image
        src={hecklersLogo}
        alt="Hecklers Alley"
        class="h-32 w-auto self-start"
      />
      <p class="text-chalk text-sm leading-loose">
        {playData.hecklersAlleyBlurb}
      </p>
      <a
        href="https://hecklersalley.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ball text-sm hover:text-ball-hover transition-colors
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
      >
        Shop Hecklers Alley →
      </a>
      <a
        href="https://hecklersalley.com/collections/mallet-parts/products/complete-mallet?variant=41418374217791"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ball text-sm hover:text-ball-hover transition-colors
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ball"
      >
        Complete Setup Bike Polo Mallet →
      </a>
    </section>
  </div>
</BaseLayout>
