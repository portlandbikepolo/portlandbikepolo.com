---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("keystatic", "code-of-conduct");
if (!entry) throw new Error("Code of Conduct content not found");
const { Content } = await render(entry);
---

<BaseLayout title="Code of Conduct — Portland Bike Polo">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1
      class="text-chalk text-5xl md:text-6xl font-medium tracking-tight text-balance mb-10"
    >
      Code of conduct
    </h1>
    <div
      class="prose prose-invert prose-p:text-chalk prose-headings:text-chalk prose-a:text-ball prose-p:leading-loose prose-p:text-pretty max-w-none"
    >
      <Content />
    </div>
  </div>
</BaseLayout>
